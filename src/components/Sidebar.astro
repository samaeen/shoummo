<script define:vars={{ base }}>
    const mobileToggle = document.getElementById("mobile-menu-toggle");
    const mobileSidebar = document.getElementById("mobile-sidebar");

    mobileToggle?.addEventListener("click", () => {
        mobileSidebar?.classList.toggle("hidden");
    });

    mobileSidebar?.addEventListener("click", (e) => {
        if (e.target === mobileSidebar) {
            mobileSidebar.classList.add("hidden");
        }
    });

    // Scroll Spy Logic
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll("aside nav a");

    // Helper to set active state
    function setActiveLink(id: string | null) {
        navLinks.forEach((link) => {
            const href = link.getAttribute("href");
            // Check if it's a homepage section link
            if (href && (href.startsWith("/#") || href.startsWith(base + "#"))) {
                const linkId = href.includes(base) ? href.split("#")[1] : href.substring(2);
                if (linkId === id) {
                    link.classList.add(
                        "bg-[var(--accent)]",
                        "text-[var(--bg-primary)]",
                        "font-bold",
                    );
                    link.classList.remove(
                        "text-[var(--text-secondary)]",
                        "hover:bg-[var(--border-color)]",
                        "hover:text-[var(--accent)]",
                    );
                } else {
                    link.classList.remove(
                        "bg-[var(--accent)]",
                        "text-[var(--bg-primary)]",
                        "font-bold",
                    );
                    link.classList.add(
                        "text-[var(--text-secondary)]",
                        "hover:bg-[var(--border-color)]",
                        "hover:text-[var(--accent)]",
                    );
                }
            } else if ((href === "/#about" || href === base + "#about") && id === "about") {
                // Explicit check for about since it might be the top section
                link.classList.add(
                    "bg-[var(--accent)]",
                    "text-[var(--bg-primary)]",
                    "font-bold",
                );
                link.classList.remove(
                    "text-[var(--text-secondary)]",
                    "hover:bg-[var(--border-color)]",
                    "hover:text-[var(--accent)]",
                );
            }
        });
    }

    // Only run on homepage
    if (window.location.pathname === "/") {
        const observerOptions = {
            root: null,
            rootMargin: "-20% 0px -60% 0px", // Trigger when section is near top
            threshold: 0,
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    setActiveLink(entry.target.id);
                }
            });
        }, observerOptions);

        sections.forEach((section) => observer.observe(section));

        // Handle "About" or top of page if no section is intersected yet (e.g. on load)
        if (window.scrollY < 100) {
            setActiveLink("about");
        }
    }
</script>
